# Apenas exemplo local. Gere outra senha para ambientes compartilhados.
ENVIRONMENT=local

# PostgreSQL para executar a API localmente (docker-compose.dev.yaml).
DB_USER=postgres
DB_NAME=squadflow
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=disable

# Opcional: DATABASE_URL, quando preenchida, tem prioridade sobre DB_*.
DATABASE_URL=

# Senha usada pelo ambiente completo do compose.yaml, com usuário squadflow.
POSTGRES_PASSWORD=dev_only_change_me
# Os registros demonstrativos são fictícios; desative em ambientes sem dados de demonstração.
DEMO_SEED=true
# Gere com: openssl rand -hex 32
JWT_SECRET=
# Obrigatórios na primeira inicialização. Depois, o admin persistido é reutilizado.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# true em produção com HTTPS
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# true permite consultar respostas nos logs da plataforma OpenAI (armazena inputs/outputs).
OPENAI_STORE_RESPONSES=false
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
AI_REPORT_TIMEOUT=210s
SERVER_WRITE_TIMEOUT=30s

# Relatórios assíncronos: all no desenvolvimento; api/worker em processos separados.
PROCESS_ROLE=all
REDIS_URL=redis://localhost:6379/0
REPORT_QUEUE_STREAM=squadflow:reports
REPORT_QUEUE_GROUP=report-workers
REPORT_WORKER_CONCURRENCY=2

# OpenTelemetry: OTLP HTTP/protobuf; sem exportação quando false.
OTEL_ENABLED=false
# Vazio usa squadflow-api / squadflow-worker / squadflow-all conforme PROCESS_ROLE.
OTEL_SERVICE_NAME=
# Para processos Go locais; o Compose usa OTEL_COLLECTOR_ENDPOINT na rede interna.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_COLLECTOR_ENDPOINT=http://otel-lgtm:4318
OTEL_TRACE_SAMPLE_RATIO=1
OTEL_METRIC_INTERVAL=15s
LOG_LEVEL=info
# Opcional para Collector remoto; use o formato aceito pelo exporter OTLP.
OTEL_EXPORTER_OTLP_HEADERS=
